{
  "name": "chips-personal-server",
  "version": "1.0.0",
  "private": true,
  "description": "薯片个人服务器（Chips Personal Server）",
  "scripts": {
    "dev": "pnpm --filter @cps/server dev",
    "start:local": "bash scripts/start-local-dev.sh start",
    "stop:local": "bash scripts/start-local-dev.sh stop",
    "status:local": "bash scripts/start-local-dev.sh status",
    "logs:local": "bash scripts/start-local-dev.sh logs",
    "build": "pnpm --filter @cps/server build && pnpm --filter @cps/web build",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "test": "pnpm --filter @cps/server test",
    "db:generate": "pnpm --filter @cps/server db:generate",
    "db:migrate": "pnpm --filter @cps/server db:migrate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "volta": {
    "extends": "../package.json"
  }
}
