FROM node:20-alpine AS builder

WORKDIR /app/Chips-PersonalServer

ENV npm_config_registry=https://registry.npmmirror.com
# 1G 内存服务器构建限制：node 堆上限 + pnpm 低并发
ENV NODE_OPTIONS="--max-old-space-size=512"
ENV PNPM_CHILD_CONCURRENCY=2

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY Chips-PersonalServer/package.json ./
COPY Chips-PersonalServer/pnpm-lock.yaml ./
COPY Chips-PersonalServer/pnpm-workspace.yaml ./
COPY Chips-PersonalServer/tsconfig.base.json ./
COPY Chips-PersonalServer/scripts ./scripts
COPY Chips-PersonalServer/packages/web/package.json ./packages/web/
COPY Chips-PersonalServer/packages/server/package.json ./packages/server/
COPY Chips-Ui /app/Chips-Ui
COPY Chips-SDK /app/Chips-SDK

# 让 Chips-Ui/Chips-SDK 源码（types 指向 src）能向上解析提升后的依赖
# shamefully-hoist：peer 依赖（react/antd 等）提升到 workspace 根 node_modules
RUN pnpm config set shamefully-hoist true
RUN ln -s /app/Chips-PersonalServer/node_modules /app/node_modules

RUN pnpm install --network-concurrency=6 --child-concurrency=2 --filter @cps/server --filter @cps/web --frozen-lockfile

COPY Chips-PersonalServer/packages/server ./packages/server
COPY Chips-PersonalServer/packages/web ./packages/web

RUN pnpm --filter @cps/server build \
 && pnpm --filter @cps/web build

FROM node:20-alpine AS production

WORKDIR /app/Chips-PersonalServer

ENV NODE_ENV=production
ENV npm_config_registry=https://registry.npmmirror.com
# 1G 内存服务器构建限制：node 堆上限 + pnpm 低并发
ENV NODE_OPTIONS="--max-old-space-size=512"
ENV PNPM_CHILD_CONCURRENCY=2

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY Chips-PersonalServer/package.json ./
COPY Chips-PersonalServer/pnpm-lock.yaml ./
COPY Chips-PersonalServer/pnpm-workspace.yaml ./
COPY Chips-PersonalServer/tsconfig.base.json ./
COPY Chips-PersonalServer/packages/server/package.json ./packages/server/

COPY Chips-Ui /app/Chips-Ui
COPY Chips-SDK /app/Chips-SDK

RUN ln -s /app/Chips-PersonalServer/node_modules /app/node_modules

RUN pnpm install --network-concurrency=6 --child-concurrency=2 --filter @cps/server --frozen-lockfile --prod

COPY --from=builder /app/Chips-PersonalServer/packages/server/dist ./packages/server/dist

WORKDIR /app/Chips-PersonalServer/packages/server

EXPOSE 3000

CMD ["node", "dist/server.js"]
