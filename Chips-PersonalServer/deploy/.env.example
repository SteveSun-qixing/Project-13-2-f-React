# 薯片社区平台服务器 - 开发环境配置
# 将此文件复制为 .env 并按实际修改

# ─── 服务器 ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# BASE_URL 为外部访问地址（默认通过 deploy/nginx/nginx.conf 暴露在 80 端口）
BASE_URL=http://localhost

# ─── 数据库（PostgreSQL） ─────────────────────────────────────────
DATABASE_URL=postgresql://ccps_user:ccps_password@localhost:5432/ccps_db

# ─── 缓存（Redis） ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── 对象存储（S3 兼容，开发默认 MinIO）────────────────────────────
S3_ENDPOINT=http://localhost:9000
# Docker 全栈模式默认会在 compose 中覆盖为 http://minio:9000；
# 若生产环境使用外部 S3 兼容对象存储，请把 S3_RUNTIME_ENDPOINT 设置为生产读写入口。
# S3_RUNTIME_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key_change_me
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# 可选：生产环境推荐配置对象存储自定义 HTTPS 域名作为公开资源前缀。
# 若留空，服务端开发态回退 S3_ENDPOINT，非开发态回退 ${BASE_URL}/cdn。
# S3_PUBLIC_URL=http://localhost/cdn
# S3_PUBLIC_URL=https://file.example.com
# 可选：将公开资源逻辑 bucket 映射到同一个物理 bucket，并以逻辑 bucket 名作为 key 前缀。
# 例如 chips-card-render-cache/{cardId}/{cacheVersion}/index.html 会写入：
#   ${S3_BUCKET_NAME}/chips-card-render-cache/{cardId}/{cacheVersion}/index.html
# 永久 .card 源文件和私有缓存始终写入独立私有 bucket。
# S3_BUCKET_NAME=chipscardspace

# ─── 安全：JWT ────────────────────────────────────────────────────
# 生产环境必须替换为 32 位以上的随机字符串
JWT_SECRET=change_me_to_a_32_char_random_string_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── 上传限制 ─────────────────────────────────────────────────────
MAX_CARD_SIZE_MB=500
MAX_BOX_SIZE_MB=100
MAX_AVATAR_SIZE_MB=5
# 卡片渲染缓存与上传会话。资源外置由 CommunityUploader 模块完成，服务器保存源 .card 并异步生成 view/cover 缓存。
CARD_RENDER_CACHE_UPLOAD_CONCURRENCY=8
CARD_RENDER_WORKER_CONCURRENCY=1
CARD_RENDER_JOB_MAX_ATTEMPTS=2
CARD_RENDER_QUEUE_POLL_TIMEOUT_SEC=5
CARD_RENDER_CACHE_TTL_DAYS=30
CARD_RENDERER_VERSION=community-card-renderer-1
UPLOAD_SESSION_TTL_MINUTES=60

# ─── 管理员初始账号（首次启动时自动创建，已存在则跳过） ──────────
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change_me_admin_password

# ─── 功能开关 ─────────────────────────────────────────────────────
ENABLE_SWAGGER=true

# ─── Host 插件安装配置（可选，逗号或换行分隔） ───────────────────
HOST_ACTIVE_THEME_ID=chips-official.default-theme
# HOST_APP_PLUGIN_PATHS=Chips-CardViewer,Chips-PhotoViewer
# HOST_CARD_PLUGIN_PATHS=Chips-BaseCardPlugin/richtext-BCP/manifest.yaml,Chips-BaseCardPlugin/image-BCP/manifest.yaml
# HOST_THEME_PLUGIN_PATHS=ThemePack/Chips-default/manifest.yaml
# HOST_MODULE_PLUGIN_PATHS=Chips-ModulePlugin/Chips-CardtoHTML-Plugin/dist/chips.module.chips.cardtohtml.plugin-0.1.0.cpk,Chips-ModulePlugin/Chips-FileConversion-Plugin/dist/chips.module.chips.fileconversion.plugin-0.1.0.cpk
