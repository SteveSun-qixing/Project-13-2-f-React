{
  "name": "@cps/server",
  "version": "1.0.0",
  "private": true,
  "description": "薯片个人服务器 - API 服务",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-server-runtime-assets.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.30.0",
    "fastify": "^4.26.2",
    "js-yaml": "^4.1.0",
    "pg": "^8.11.5",
    "pino": "^9.1.0",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.4",
    "@types/unzipper": "^0.10.9",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.20.0",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
