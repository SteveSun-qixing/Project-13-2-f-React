{
  "name": "chips-ecosystem-workspace",
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "22.18.0",
    "npm": "10.9.3"
  },
  "workspaces": [
    "Chip-iconMaker",
    "Chips-BaseCardPlugin/*",
    "Chips-BookReader",
    "Chips-BoxLayoutPlugin/*",
    "Chips-CardViewer",
    "Chips-CommunityClient",
    "Chips-CommunityPlatformServer",
    "Chips-CommunityPlatformServer/packages/*",
    "Chips-EcoSettingsPanel",
    "Chips-EditingEngine",
    "Chips-Host",
    "Chips-ModulePlugin/*",
    "Chips-MusicPlayer",
    "Chips-PhotoViewer",
    "Chips-RichTextEditor",
    "Chips-Scaffold/*",
    "Chips-SDK",
    "Chips-Ui",
    "Chips-UniversalFileViewer",
    "Chips-VideoPlayer"
  ],
  "scripts": {
    "materials:inventory": "node ./scripts/collect-finished-product-materials.mjs",
    "verify:workspace": "node ./scripts/verify-ecosystem-workspace.mjs",
    "package:pre-release": "node ./scripts/package-ecosystem-release.mjs --output=打包/V0.01",
    "package:list": "node ./scripts/package-ecosystem-release.mjs --list-plugins"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "chips-host": "0.1.0",
    "chips-sdk": "0.1.0"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
