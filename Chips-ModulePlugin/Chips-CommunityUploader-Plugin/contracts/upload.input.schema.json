{
  "type": "object",
  "required": ["cardFile", "server"],
  "properties": {
    "cardFile": {
      "type": "string"
    },
    "server": {
      "type": "object",
      "required": ["baseUrl", "accessToken"],
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "accessToken": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "properties": {
        "roomId": {
          "type": ["string", "null"]
        },
        "idempotencyKey": {
          "type": "string"
        },
        "includeRenderArtifacts": {
          "type": "boolean",
          "description": "是否随本地上传一并上传客户端渲染产物（查看 HTML 与封面 HTML）。true 为个人服务器模式，false（默认）仅上传源文件。"
        }
      },
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "tempDir": {
          "type": "string"
        },
        "keepNetworkCard": {
          "type": "boolean"
        },
        "networkCardPath": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
