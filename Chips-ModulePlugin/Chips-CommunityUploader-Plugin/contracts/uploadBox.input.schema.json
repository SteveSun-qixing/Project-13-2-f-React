{
  "type": "object",
  "required": ["boxFile", "server"],
  "properties": {
    "boxFile": {
      "type": "string"
    },
    "server": {
      "type": "object",
      "required": ["baseUrl", "accessToken"],
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "accessToken": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "publish": {
      "type": "object",
      "properties": {
        "roomId": {
          "type": ["string", "null"]
        },
        "idempotencyKey": {
          "type": "string"
        },
        "includeRenderArtifacts": {
          "type": "boolean",
          "description": "透传给箱子内散落卡片上传（见 upload 的 includeRenderArtifacts）。"
        }
      },
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "tempDir": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
