{
  "name": "Chips-UniversalFileViewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "chipsdev-r server",
    "build": "chipsdev-r build",
    "test": "chipsdev-r test",
    "lint": "chipsdev-r lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "chipsdev-r validate",
    "preview:smoke": "chipsdev-r preview --mode mock --target app --json --out reports/preview/app-preview-smoke.json && node src/preview/preview-smoke.js",
    "quality:gate": "chipsdev-r quality gate --json --out reports/quality/quality-gate.json",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run validate && npm run preview:smoke && npm run quality:gate"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.0.3",
    "@ant-design/icons": "6.3.2",
    "@chips/ui": "0.1.0",
    "@kenjiuno/msgreader": "1.28.0",
    "@mapbox/togeojson": "0.16.2",
    "ag-psd": "30.2.0",
    "antd": "6.5.4",
    "dayjs": "1.11.21",
    "docx-preview": "0.3.7",
    "dompurify": "3.4.10",
    "emf-converter": "2.0.2",
    "heic2any": "0.0.4",
    "hls.js": "1.6.16",
    "hyparquet": "1.26.1",
    "jszip": "3.10.1",
    "leaflet": "1.9.4",
    "mammoth": "1.12.0",
    "marked": "18.0.4",
    "mermaid": "11.16.0",
    "pako": "2.1.0",
    "pdfjs-dist": "4.10.38",
    "postal-mime": "2.7.4",
    "prismjs": "1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "seek-bzip": "2.0.0",
    "shpjs": "6.2.0",
    "three": "0.184.0",
    "topojson-client": "3.1.0",
    "utif": "3.1.0",
    "xlsx": "npm:@stackline/xlsx@1.0.6",
    "xz-decompress": "0.2.3"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/pako": "2.0.4",
    "@types/prismjs": "1.26.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "0.184.0",
    "@types/topojson-client": "3.1.5",
    "chips-sdk": "^0.1.0",
    "eslint": "^8.57.1",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "volta": {
    "extends": "../package.json"
  }
}
