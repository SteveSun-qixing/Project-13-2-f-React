{
  "name": "@chips/community-server",
  "version": "0.1.0",
  "private": true,
  "description": "薯片社区平台服务器：API 域（认证与账号域、内容只读域、分页幂等限流与错误归一中间件）",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-db-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "db:generate": "drizzle-kit generate",
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@fastify/cookie": "9.3.1",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/multipart": "8.3.0",
    "@fastify/swagger": "8.14.0",
    "@fastify/swagger-ui": "4.0.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^4.26.2",
    "pg": "^8.16.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
