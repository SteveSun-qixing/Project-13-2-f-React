{
  "name": "@chips/host",
  "version": "0.1.0",
  "private": true,
  "description": "薯片生态桌面壳：Electron 主进程、preload 桥、壳窗口渲染进程与平台启动编排",
  "main": "./dist/main/main.js",
  "scripts": {
    "dev": "pnpm run build && electron ./dist/main/self-check.js",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer && pnpm run build:types",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts && node ./scripts/copy-renderer-html.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run tests/contract",
    "lint": "eslint . && prettier --check .",
    "clean": "node ./scripts/clean.mjs"
  },
  "dependencies": {
    "@chips/ui": "workspace:*",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "electron": "40.8.0",
    "eslint": "9.39.5",
    "jsdom": "28.1.0",
    "prettier": "3.9.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
