{
  "name": "@chips/ui",
  "version": "0.1.0",
  "private": true,
  "description": "共享层：Design Tokens、ChipsProvider、命令运行时与薯片共享组件，前端唯一导入面",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global.css": "./dist/global.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/global.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner",
    "lint": "eslint . && prettier --check .",
    "clean": "node -e \"import('node:fs').then((fs) => { for (const p of ['dist', 'coverage', 'tsconfig.tsbuildinfo']) fs.rmSync(p, { recursive: true, force: true }); })\""
  },
  "dependencies": {
    "@chips/antd": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@chips/testing": "workspace:*",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "28.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
