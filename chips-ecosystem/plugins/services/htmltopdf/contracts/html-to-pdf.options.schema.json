{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-chips-schema-version": 1,
  "title": "HTML 转 PDF 选项（content-converter.html-to-pdf）",
  "description": "原子操作 htmlToPdf 的选项面；缺省值与语义以本 schema 为准，实现内二次校验口径一致。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pageSize": {
      "type": "string",
      "enum": ["A4", "A3", "Letter", "Legal"],
      "default": "A4",
      "title": "纸张规格"
    },
    "landscape": {
      "type": "boolean",
      "default": false,
      "title": "横向打印（宽高互换）"
    },
    "margins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "type": "number", "minimum": 0, "maximum": 50, "title": "上边距（毫米）", "default": 10 },
        "right": { "type": "number", "minimum": 0, "maximum": 50, "title": "右边距（毫米）", "default": 10 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 50, "title": "下边距（毫米）", "default": 10 },
        "left": { "type": "number", "minimum": 0, "maximum": 50, "title": "左边距（毫米）", "default": 10 }
      },
      "title": "页边距（毫米）"
    },
    "printBackground": {
      "type": "boolean",
      "default": true,
      "title": "打印背景图形与颜色"
    },
    "preferCSSPageSize": {
      "type": "boolean",
      "default": false,
      "title": "优先使用 HTML 内 @page 声明的页面尺寸"
    },
    "scale": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 2,
      "default": 1,
      "title": "打印缩放系数"
    },
    "headerFooter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false, "title": "启用页眉页脚" },
        "headerTemplate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "title": "页眉模板（打印承载模板文法）"
        },
        "footerTemplate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "title": "页脚模板（打印承载模板文法）"
        },
        "headerHeightMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 10,
          "title": "页眉预留高度（毫米）"
        },
        "footerHeightMm": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "default": 10,
          "title": "页脚预留高度（毫米）"
        }
      },
      "title": "页眉页脚"
    }
  }
}
