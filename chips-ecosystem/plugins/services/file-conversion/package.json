{
  "name": "@chips/service-file-conversion",
  "version": "0.1.0",
  "private": true,
  "description": "文件转换编排内容处理服务插件（card/html → html/pdf/image 链路编排）",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.main.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then((fs) => { fs.rmSync('dist', { recursive: true, force: true }); })\""
  },
  "dependencies": {
    "@chips/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "3.2.4"
  }
}
