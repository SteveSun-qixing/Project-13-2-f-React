{
  "name": "@chips/plugin-universal-file-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "万能文件查看器",
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.main.config.ts && vite build --config vite.render.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"import('node:fs').then((fs) => { for (const p of ['dist', 'render.js', 'coverage']) fs.rmSync(p, { recursive: true, force: true }); })\"",
    "package": "pnpm exec chips plugin pack --out dist/"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.0.3",
    "@kenjiuno/msgreader": "1.28.0",
    "@mapbox/togeojson": "0.16.2",
    "ag-psd": "30.2.0",
    "docx-preview": "0.3.7",
    "dompurify": "3.4.10",
    "emf-converter": "2.0.2",
    "heic2any": "0.0.4",
    "hls.js": "1.6.16",
    "hyparquet": "1.26.1",
    "jszip": "3.10.1",
    "leaflet": "1.9.4",
    "mammoth": "1.12.0",
    "marked": "18.0.4",
    "mermaid": "11.16.0",
    "pako": "2.1.0",
    "pdfjs-dist": "4.10.38",
    "postal-mime": "2.7.4",
    "prismjs": "1.30.0",
    "seek-bzip": "2.0.0",
    "shpjs": "6.2.0",
    "three": "0.184.0",
    "topojson-client": "3.1.0",
    "utif": "3.1.0",
    "xlsx": "npm:@stackline/xlsx@1.0.6",
    "xz-decompress": "0.2.3"
  },
  "devDependencies": {
    "@chips/cli": "workspace:*",
    "@chips/sdk": "workspace:*",
    "@chips/ui": "workspace:*",
    "@types/leaflet": "1.9.20",
    "@types/pako": "2.0.4",
    "@types/prismjs": "1.26.6",
    "@types/three": "0.184.0",
    "@types/topojson-client": "3.1.5",
    "@types/node": "20.19.37",
    "@types/react": "18.3.29",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "28.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "3.2.4"
  }
}
