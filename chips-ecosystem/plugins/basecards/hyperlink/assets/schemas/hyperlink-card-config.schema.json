{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "超链接基础卡片配置",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "anchor_text": {
      "type": "string",
      "default": "",
      "description": "链接的显示标题（锚点文本）"
    },
    "url": {
      "type": "string",
      "default": "",
      "description": "链接地址；非空时必须是可打开的 http(s) 地址（由 validateConfig 补充校验）"
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "显示在标题下方的说明文字"
    },
    "icon_url": {
      "type": "string",
      "default": "",
      "description": "可选的 http(s) 图标图片地址；未填写或加载失败时显示默认图标"
    },
    "display_density": {
      "type": "string",
      "enum": ["compact", "comfortable", "spacious"],
      "default": "comfortable",
      "description": "展示密度"
    },
    "show_security_hint": {
      "type": "boolean",
      "default": true,
      "description": "是否在链接标题旁显示安全状态提示"
    }
  }
}
