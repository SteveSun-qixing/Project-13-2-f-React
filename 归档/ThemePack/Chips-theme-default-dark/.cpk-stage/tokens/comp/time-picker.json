{
  "chips": {
    "comp": {
      "time-picker": {
        "root": {
          "radius": "{chips.sys.radius.container}",
          "surface": {
            "idle": "{chips.sys.color.surface-raised}",
            "focus": "{chips.sys.color.surface-raised}",
            "disabled": "{chips.sys.color.surface}"
          },
          "border": {
            "idle": "{chips.sys.color.border-subtle}",
            "focus": "{chips.sys.color.focus-ring}",
            "error": "{chips.sys.color.error}"
          }
        },
        "label": {
          "color": "{chips.sys.color.on-surface}"
        },
        "control": {
          "color": "{chips.sys.color.on-surface}"
        },
        "placeholder": {
          "color": "{chips.sys.color.on-surface-muted}"
        },
        "trigger": {
          "color": {
            "idle": "{chips.sys.color.on-surface-soft}",
            "hover": "{chips.sys.color.primary-hover}"
          }
        },
        "list": {
          "surface": "{chips.sys.color.surface-raised}",
          "border": "{chips.sys.color.border-subtle}"
        },
        "option": {
          "surface": {
            "idle": "transparent",
            "highlighted": "{chips.sys.color.surface-accent}",
            "selected": "{chips.sys.color.primary}",
            "disabled": "transparent"
          },
          "text": {
            "color": "{chips.sys.color.on-surface}"
          }
        },
        "description": {
          "color": "{chips.sys.color.on-surface-muted}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.focus-ring}"
        }
      }
    }
  }
}
