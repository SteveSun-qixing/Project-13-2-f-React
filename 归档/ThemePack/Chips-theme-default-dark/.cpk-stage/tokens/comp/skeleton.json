{
  "chips": {
    "comp": {
      "skeleton": {
        "root": {
          "surface": "{chips.sys.color.surface-raised}"
        },
        "item": {
          "surface": {
            "idle": "{chips.sys.color.surface}",
            "active": "{chips.sys.color.surface-accent}"
          },
          "motion": {
            "duration": "{chips.motion.duration.slow}",
            "easing": "{chips.motion.easing.standard}",
            "stagger": "{chips.motion.stagger.item}",
            "reduced-duration": "{chips.motion.reduced.duration}"
          }
        },
        "status": {
          "color": {
            "info": "{chips.sys.color.info}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.focus-ring}"
        }
      }
    }
  }
}
