{
  "chips": {
    "comp": {
      "spinner": {
        "root": {
          "size": "24cpx"
        },
        "track": {
          "color": "{chips.sys.color.surface}"
        },
        "indicator": {
          "color": "{chips.sys.color.primary}",
          "thickness": "2px"
        },
        "motion": {
          "duration": "{chips.motion.duration.normal}"
        },
        "status": {
          "color": {
            "info": "{chips.sys.color.info}",
            "error": "{chips.sys.color.error}"
          }
        }
      }
    }
  }
}
