{
  "chips": {
    "comp": {
      "rating": {
        "root": {
          "gap": "{chips.layout.gap.xs}"
        },
        "item": {
          "size": "{chips.layout.density.comfortable}",
          "radius": "{chips.sys.radius.container}",
          "surface": {
            "idle": "transparent",
            "hover": "{chips.sys.color.surface}",
            "active": "transparent",
            "disabled": "transparent"
          }
        },
        "icon": {
          "color": {
            "idle": "{chips.sys.icon.color-muted}",
            "active": "{chips.sys.color.primary}",
            "heart-active": "{chips.sys.color.error}",
            "disabled": "{chips.sys.icon.color-disabled}"
          }
        },
        "label": {
          "color": "{chips.sys.color.on-surface}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
