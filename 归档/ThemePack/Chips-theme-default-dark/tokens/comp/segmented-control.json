{
  "chips": {
    "comp": {
      "segmented-control": {
        "root": {
          "radius": "{chips.sys.radius.container}",
          "surface": "{chips.sys.color.surface-raised}",
          "border": "{chips.sys.color.border-subtle}"
        },
        "item": {
          "surface": {
            "idle": "transparent",
            "hover": "{chips.sys.color.surface-elevated}",
            "active": "{chips.sys.color.primary-active}",
            "selected": "{chips.sys.color.primary}",
            "disabled": "{chips.sys.color.surface}"
          }
        },
        "label": {
          "color": {
            "idle": "{chips.sys.color.on-surface}",
            "selected": "{chips.sys.color.primary-contrast}",
            "disabled": "{chips.sys.color.on-surface-soft}"
          }
        },
        "indicator": {
          "surface": "{chips.sys.color.focus-ring}"
        },
        "focus": {
          "outline": "{chips.sys.color.focus-ring}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        }
      }
    }
  }
}
