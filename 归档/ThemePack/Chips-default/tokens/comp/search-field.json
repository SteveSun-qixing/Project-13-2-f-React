{
  "chips": {
    "comp": {
      "search-field": {
        "root": {
          "radius": "{chips.ref.radius.control}",
          "surface": {
            "idle": "{chips.ref.color.gray-75}",
            "focus": "{chips.sys.color.surface}",
            "disabled": "{chips.ref.color.gray-100}"
          },
          "border": {
            "idle": "{chips.ref.color.gray-200}",
            "focus": "{chips.sys.color.primary}",
            "error": "{chips.sys.color.error}"
          }
        },
        "label": {
          "color": "{chips.sys.color.on-surface}"
        },
        "control": {
          "color": "{chips.sys.color.on-surface}"
        },
        "placeholder": {
          "color": "{chips.ref.color.gray-500}"
        },
        "description": {
          "color": "{chips.ref.color.gray-500}"
        },
        "icon": {
          "color": "{chips.sys.color.on-surface}"
        },
        "clear": {
          "color": {
            "idle": "{chips.ref.color.gray-500}",
            "hover": "{chips.sys.color.primary}"
          }
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
