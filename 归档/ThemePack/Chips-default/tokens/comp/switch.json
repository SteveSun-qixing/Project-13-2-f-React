{
  "chips": {
    "comp": {
      "switch": {
        "track": {
          "radius": "{chips.ref.radius.pill}",
          "surface": {
            "off": "{chips.ref.color.gray-50}",
            "on": "{chips.sys.color.primary}",
            "disabled": "{chips.ref.color.gray-100}"
          }
        },
        "thumb": {
          "surface": "{chips.sys.color.surface}"
        },
        "label": {
          "color": "{chips.sys.color.on-surface}"
        }
      }
    }
  }
}
