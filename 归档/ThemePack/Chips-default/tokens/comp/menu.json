{
  "chips": {
    "comp": {
      "menu": {
        "content": {
          "radius": "{chips.sys.radius.container}",
          "surface": "{chips.sys.color.surface}"
        },
        "item": {
          "surface": {
            "hover": "{chips.ref.color.gray-50}",
            "active": "{chips.ref.color.blue-50}"
          },
          "text": {
            "color": "{chips.sys.color.on-surface}"
          }
        },
        "group": {
          "label": {
            "color": "{chips.ref.color.gray-500}"
          }
        },
        "separator": {
          "color": "{chips.ref.color.gray-200}",
          "thickness": "{chips.layout.divider.thickness}"
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
