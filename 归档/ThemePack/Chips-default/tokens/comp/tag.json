{
  "chips": {
    "comp": {
      "tag": {
        "root": {
          "radius": "{chips.ref.radius.pill}",
          "surface": {
            "idle": "{chips.sys.color.surface}",
            "hover": "{chips.ref.color.gray-75}",
            "active": "{chips.ref.color.blue-50}",
            "disabled": "{chips.ref.color.gray-100}",
            "error": "{chips.sys.color.error}"
          }
        },
        "label": {
          "color": {
            "idle": "{chips.sys.color.on-surface}",
            "disabled": "{chips.ref.color.gray-400}",
            "error": "{chips.sys.color.surface}"
          }
        },
        "icon": {
          "color": {
            "idle": "{chips.ref.color.gray-500}",
            "disabled": "{chips.ref.color.gray-400}"
          }
        },
        "close": {
          "color": {
            "idle": "{chips.ref.color.gray-500}",
            "hover": "{chips.sys.color.primary}",
            "disabled": "{chips.ref.color.gray-500}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        }
      }
    }
  }
}
