{
  "chips": {
    "comp": {
      "form": {
        "root": {
          "gap": "{chips.ref.space.3}"
        },
        "section": {
          "gap": "{chips.ref.space.3}",
          "divider": {
            "color": "{chips.ref.color.gray-200}"
          }
        },
        "field": {
          "gap": "{chips.layout.gap.xs}"
        },
        "label": {
          "color": "{chips.sys.color.on-surface}",
          "required": {
            "color": "{chips.sys.color.error}"
          }
        },
        "control": {
          "surface": {
            "idle": "{chips.sys.color.surface}"
          },
          "border": {
            "idle": "{chips.ref.color.gray-200}",
            "error": "{chips.sys.color.error}"
          }
        },
        "hint": {
          "color": "{chips.ref.color.gray-500}"
        },
        "error": {
          "color": "{chips.sys.color.error}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
