{
  "chips": {
    "comp": {
      "dialog": {
        "backdrop": {
          "surface": "{chips.sys.color.on-surface}"
        },
        "content": {
          "radius": "{chips.sys.radius.container}",
          "surface": "{chips.sys.color.surface}"
        },
        "header": {
          "color": "{chips.sys.color.on-surface}"
        },
        "body": {
          "color": "{chips.sys.color.on-surface}"
        },
        "footer": {
          "gap": "{chips.ref.space.3}"
        },
        "actions": {
