{
  "chips": {
    "comp": {
      "time-picker": {
        "root": {
          "radius": "{chips.sys.radius.container}",
          "surface": {
            "idle": "{chips.sys.color.surface}",
            "focus": "{chips.sys.color.surface}",
            "disabled": "{chips.ref.color.gray-100}"
          },
          "border": {
            "idle": "{chips.ref.color.gray-200}",
            "focus": "{chips.sys.color.primary}",
            "error": "{chips.sys.color.error}"
          }
        },
        "label": {
          "color": "{chips.sys.color.on-surface}"
        },
        "control": {
          "color": "{chips.sys.color.on-surface}"
        },
        "placeholder": {
          "color": "{chips.ref.color.gray-500}"
        },
        "trigger": {
          "color": {
            "idle": "{chips.ref.color.gray-600}",
            "hover": "{chips.sys.color.primary}"
          }
        },
        "list": {
          "surface": "{chips.sys.color.surface}",
          "border": "{chips.ref.color.gray-200}"
        },
        "option": {
          "surface": {
            "idle": "transparent",
            "highlighted": "{chips.ref.color.blue-50}",
            "selected": "{chips.ref.color.blue-50}",
            "disabled": "transparent"
          },
          "text": {
            "color": "{chips.sys.color.on-surface}"
          }
        },
        "description": {
          "color": "{chips.ref.color.gray-500}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
