{
  "chips": {
    "comp": {
      "progress": {
        "track": {
          "height": "6px",
          "radius": "{chips.sys.radius.container}",
          "surface": "{chips.sys.color.surface}"
        },
        "range": {
          "surface": {
            "determinate": "{chips.sys.color.primary}",
            "indeterminate": "{chips.sys.color.primary}"
          },
          "motion": {
            "duration": "{chips.motion.duration.normal}",
            "easing": "{chips.motion.easing.standard}",
            "reduced-duration": "{chips.motion.reduced.duration}"
          }
        },
        "label": {
          "color": "{chips.sys.color.on-surface}"
        },
        "value": {
          "color": "{chips.ref.color.gray-600}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
