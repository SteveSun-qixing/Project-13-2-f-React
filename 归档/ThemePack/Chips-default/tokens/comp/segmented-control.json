{
  "chips": {
    "comp": {
      "segmented-control": {
        "root": {
          "radius": "{chips.ref.radius.control}",
          "surface": "{chips.ref.color.gray-75}",
          "border": "{chips.ref.color.gray-200}"
        },
        "item": {
          "surface": {
            "idle": "transparent",
            "hover": "{chips.sys.color.surface}",
            "active": "{chips.ref.color.blue-50}",
            "selected": "{chips.sys.color.surface}",
            "disabled": "{chips.ref.color.gray-100}"
          }
        },
        "label": {
          "color": {
            "idle": "{chips.sys.color.on-surface}",
            "selected": "{chips.sys.color.primary}",
            "disabled": "{chips.ref.color.gray-400}"
          }
        },
        "indicator": {
          "surface": "{chips.sys.color.primary}"
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        }
      }
    }
  }
}
