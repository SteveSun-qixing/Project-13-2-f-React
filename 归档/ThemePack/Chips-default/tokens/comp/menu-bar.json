{
  "chips": {
    "comp": {
      "menu-bar": {
        "root": {
          "surface": "{chips.sys.color.surface}"
        },
        "menu": {
          "surface": {
            "idle": "{chips.sys.color.surface}",
            "hover": "{chips.ref.color.gray-75}"
          }
        },
        "item": {
          "surface": {
            "hover": "{chips.ref.color.blue-50}"
          },
          "text": {
            "color": "{chips.sys.color.on-surface}"
          },
          "icon": {
            "color": "{chips.sys.icon.color}",
            "color-disabled": "{chips.sys.icon.color-disabled}"
          }
        },
        "shortcut": {
          "color": "{chips.ref.color.gray-500}"
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
