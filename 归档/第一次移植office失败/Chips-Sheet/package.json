{
  "name": "Chips-Sheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "chipsdev-r server",
    "build": "chipsdev-r build",
    "test": "chipsdev-r test",
    "lint": "chipsdev-r lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "chipsdev-r validate",
    "preview:smoke": "chipsdev-r preview --mode mock --target app --json --out reports/preview/app-preview-smoke.json && node src/preview/preview-smoke.js",
    "quality:gate": "chipsdev-r quality gate --json --out reports/quality/quality-gate.json",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run validate && npm run preview:smoke && npm run quality:gate"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@chips/ui": "0.1.0",
    "@fluentui/react-icons": "^2.0.316",
    "@univerjs/core": "0.25.1",
    "@univerjs/data-validation": "0.25.1",
    "@univerjs/engine-render": "0.25.1",
    "@univerjs/find-replace": "0.25.1",
    "@univerjs/preset-sheets-conditional-formatting": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/preset-sheets-data-validation": "0.25.1",
    "@univerjs/preset-sheets-drawing": "0.25.1",
    "@univerjs/preset-sheets-filter": "0.25.1",
    "@univerjs/preset-sheets-find-replace": "0.25.1",
    "@univerjs/preset-sheets-note": "0.25.1",
    "@univerjs/preset-sheets-sort": "0.25.1",
    "@univerjs/preset-sheets-table": "0.25.1",
    "@univerjs/sheets-filter": "0.25.1",
    "@univerjs/themes": "0.25.1",
    "antd": "6.5.4",
    "dayjs": "1.11.21",
    "exceljs": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.5.0",
    "eslint": "^8.57.1",
    "@typescript-eslint/parser": "^7.18.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "chips-sdk": "^0.1.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/react": "^14.3.1"
  },
  "volta": {
    "extends": "../package.json"
  }
}
