{
  "chips": {
    "motion": {
      "duration": {
        "instant": "0ms",
        "fast": "150ms",
        "normal": "250ms",
        "slow": "360ms",
        "emphasized": "420ms"
      },
      "easing": {
        "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
        "entrance": "cubic-bezier(0, 0, 0.2, 1)",
        "exit": "cubic-bezier(0.4, 0, 1, 1)",
        "emphasized": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "delay": {
        "none": "0ms",
        "short": "50ms",
        "medium": "100ms"
      },
      "stagger": {
        "none": "0ms",
        "item": "32ms",
        "group": "60ms"
      },
      "distance": {
        "xs": "2px",
        "sm": "4px",
        "md": "8px",
        "lg": "16px"
      },
      "opacity": {
        "enter": 0,
        "exit": 0,
        "visible": 1
      },
      "scale": {
        "enter": 0.98,
        "pressed": 0.98,
        "drag": 1.02
      },
      "reduced": {
        "duration": "0ms",
        "distance": "0px",
        "scale": 1,
        "opacity": 1
      },
      "scene": {
        "transition-duration": "{chips.motion.duration.normal}",
        "transition-easing": "{chips.motion.easing.emphasized}",
        "distance": "{chips.motion.distance.lg}"
      },
      "overlay": {
        "enter-duration": "{chips.motion.duration.normal}",
        "exit-duration": "{chips.motion.duration.fast}",
        "easing": "{chips.motion.easing.entrance}",
        "distance": "{chips.motion.distance.md}",
        "scale": "{chips.motion.scale.enter}"
      },
      "menu": {
        "enter-duration": "{chips.motion.duration.fast}",
        "exit-duration": "{chips.motion.duration.fast}",
        "easing": "{chips.motion.easing.standard}",
        "distance": "{chips.motion.distance.sm}"
      },
      "list": {
        "reorder-duration": "{chips.motion.duration.normal}",
        "reorder-easing": "{chips.motion.easing.standard}",
        "stagger": "{chips.motion.stagger.item}"
      },
      "drag": {
        "feedback-duration": "{chips.motion.duration.fast}",
        "feedback-easing": "{chips.motion.easing.emphasized}",
        "scale": "{chips.motion.scale.drag}"
      },
      "theme": {
        "switch-duration": "{chips.motion.duration.normal}",
        "switch-easing": "{chips.motion.easing.standard}"
      }
    }
  }
}
