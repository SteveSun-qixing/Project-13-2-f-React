{
  "chips": {
    "comp": {
      "slider": {
        "root": {
          "gap": "{chips.layout.gap.xs}"
        },
        "label": {
          "color": "{chips.sys.color.on-surface}"
        },
        "track": {
          "height": "6px",
          "radius": "{chips.sys.radius.container}",
          "surface": {
            "idle": "{chips.sys.color.surface}",
            "disabled": "{chips.sys.color.surface}"
          }
        },
        "range": {
          "surface": {
            "idle": "{chips.sys.color.primary}",
            "disabled": "{chips.sys.color.on-surface}"
          }
        },
        "thumb": {
          "size": "18px",
          "radius": "{chips.sys.radius.container}",
          "surface": {
            "idle": "{chips.sys.color.surface}",
            "hover": "{chips.sys.color.surface}",
            "active": "{chips.sys.color.primary}",
            "disabled": "{chips.sys.color.surface}"
          },
          "border": {
            "idle": "{chips.sys.color.primary}",
            "focus": "{chips.sys.color.primary}"
          }
        },
        "value": {
          "color": "{chips.sys.color.on-surface}"
        },
        "status": {
          "color": {
            "error": "{chips.sys.color.error}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
