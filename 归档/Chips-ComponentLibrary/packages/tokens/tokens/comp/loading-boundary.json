{
  "chips": {
    "comp": {
      "loading-boundary": {
        "root": {
          "surface": "{chips.sys.color.surface}"
        },
        "fallback": {
          "surface": "{chips.sys.color.surface}"
        },
        "skeleton": {
          "surface": {
            "idle": "{chips.sys.color.surface}",
            "active": "{chips.sys.color.primary}"
          },
          "motion": {
            "duration": "{chips.motion.duration.slow}",
            "easing": "{chips.motion.easing.standard}",
            "reduced-duration": "{chips.motion.reduced.duration}"
          }
        },
        "status": {
          "color": {
            "info": "{chips.sys.color.primary}"
          }
        },
        "focus": {
          "outline": "{chips.sys.color.primary}"
        }
      }
    }
  }
}
